{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/icons/*", "/fonts/*", "/*.css", "/*.js", "/*.webmanifest", "/*.png"]
  },
  "routes": [
    { "route": "/api/*", "allowedRoles": ["anonymous"] },
    { "route": "/*", "allowedRoles": ["anonymous"] }
  ],
  "globalHeaders": {
    "Cache-Control": "no-cache"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },
  "platform": {
    "apiRuntime": "node:22"
  }
}
